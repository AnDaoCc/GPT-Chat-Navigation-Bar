{
  "manifest_version": 3,
  "name": "GPT聊天导航器",
  "version": "2026.1.0",
  "version_name": "2026-V1版",
  "description": "GPT聊天导航器：为 ChatGPT 增加本地对话导航、阅读定位和显示调节。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GPT聊天导航器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["assets/contentScript.js"],
      "css": ["assets/contentScript.css"],
      "run_at": "document_idle"
    }
  ]
}
